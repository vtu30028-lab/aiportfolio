# ==========================================
# PortfolioAI Environment Variables Configuration
# ==========================================

# Flask Environment
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=super-secret-development-key-change-in-production-32chars-min

# Database Connection
# SQLite for local development: sqlite:///portfolio.db
# PostgreSQL for production: postgresql://username:password@localhost:5432/portfolio_ai
DATABASE_URL=sqlite:///portfolio.db

# Google Gemini API
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
MAX_CONTENT_LENGTH_MB=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Optional: GitHub Personal Access Token (for extended rate limits on GitHub imports)
GITHUB_ACCESS_TOKEN=
